# magick-agency production settings for docker/docker-compose.prod.yml. Copy to
# docker/.env.prod (git-ignored) and fill in. Compose reads this file twice: as the
# server's environment (env_file) and, with `--env-file docker/.env.prod`, for the
# ${...} values in the compose file (the web build args and published ports).
# Every server setting, its default and its reasoning: docs/operations.md and
# apps/server/.env.example. NODE_ENV, PORT and REDIS_URL are set by the compose file.

# ── Postgres (TLS-enabled; verified) ──────────────────────────────────
# No TLS parameters (ssl, sslmode, sslrootcert, ...) here: refused at boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/magick_agency
# PEM TEXT of a private CA (one line with \n escapes), when the database's certificate
# is not signed by a public root. Unset = Node's roots, still verified.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----

# ── Proxy hops ────────────────────────────────────────────────────────
# 1 = the bundled nginx only. 2 if a load balancer / TLS terminator fronts it.
TRUST_PROXY_HOPS=1

# ── Required in production (boot refuses without them) ────────────────
FIREBASE_PROJECT_ID=
# The service-account JSON, inline.
FIREBASE_SERVICE_ACCOUNT_KEY=
TELEPHONY_ENABLED_PROVIDERS=voicelink
VOICELINK_BASE_URL=
VOICELINK_USERNAME=
VOICELINK_PASSWORD=
# The console's public https origin: nginx routes /api/* (webhooks, media) to the server.
VOICELINK_WEBHOOK_BASE_URL=https://agency.example.com
VOICELINK_DEFAULT_CALLER_ID=

# ── Strongly recommended ──────────────────────────────────────────────
SUPER_ADMIN_JWT_SECRET=
RECORDING_URL_SIGNING_SECRET=
CONSOLE_BASE_URL=https://agency.example.com
MAILJET_API_KEY=
MAILJET_API_SECRET=
# S3_AUDIO_BUCKET=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Console build (inlined at image build time; public values) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_POSTHOG_KEY=
# VITE_BRAND=magick-agency

# ── Published ports ───────────────────────────────────────────────────
# CONSOLE_BIND=0.0.0.0
# CONSOLE_PORT=8080
# SUPER_ADMIN_BIND=127.0.0.1
# SUPER_ADMIN_PORT=8081
