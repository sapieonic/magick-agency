# magick-agency production settings for docker/docker-compose.prod.yml. Copy to
# docker/.env (git-ignored) and fill in. Compose reads it twice, automatically:
# for the ${...} values in the compose file (web build args, published ports) and
# as the server's environment (env_file). NODE_ENV, PORT and REDIS_URL are set by
# the compose file. Every server setting, its default and its reasoning:
# docs/operations.md and apps/server/.env.example.
#
# QUOTING. Compose parses this file: an unquoted `$` starts a variable (`pa$word`
# becomes `pa`) and ` #` starts a comment. Wrap any value that may contain either
# (passwords, secrets, DATABASE_URL) in SINGLE quotes: KEY='pa$word #1'. A literal
# `\n` inside a value is kept as-is, which is what DB_SSL_CA and an inline
# FIREBASE_SERVICE_ACCOUNT_KEY need.

# ── Postgres (TLS-enabled; verified) ──────────────────────────────────
# No TLS parameters (ssl, sslmode, sslrootcert, ...) here: refused at boot.
DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/magick_agency'
# PEM TEXT of a private CA (one line with \n escapes), when the database's certificate
# is not signed by a public root. Unset = Node's roots, still verified.
# DB_SSL_CA='-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----'

# ── Proxy hops ────────────────────────────────────────────────────────
# 2 = your TLS terminator + the bundled nginx (the supported topology; TLS in front
# of nginx :8080 is mandatory). Each further proxy in front adds one. Never 1 here:
# every client would then share the TLS terminator's rate-limit bucket.
TRUST_PROXY_HOPS=2

# ── Required in production (boot refuses without them) ────────────────
FIREBASE_PROJECT_ID=
# The service-account JSON, inline, single-quoted.
FIREBASE_SERVICE_ACCOUNT_KEY=
TELEPHONY_ENABLED_PROVIDERS=voicelink
VOICELINK_BASE_URL=
VOICELINK_USERNAME=
VOICELINK_PASSWORD=
# The console's public https origin: nginx routes /api/* (webhooks, media) to the server.
VOICELINK_WEBHOOK_BASE_URL=https://agency.example.com
VOICELINK_DEFAULT_CALLER_ID=

# ── Strongly recommended ──────────────────────────────────────────────
# 16+ characters each.
SUPER_ADMIN_JWT_SECRET=
RECORDING_URL_SIGNING_SECRET=
CONSOLE_BASE_URL=https://agency.example.com
MAILJET_API_KEY=
MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=
# MAILJET_FROM_NAME=
# S3_AUDIO_BUCKET=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Post-call analysis (optional) ─────────────────────────────────────
# Off unless a transcriber key and an LLM key are both present.
# DIALER_ANALYSIS_ENABLED=true
# DIALER_TRANSCRIBER=gemini
# GEMINI_API_KEY=
# POST_CALL_ANALYSIS_PROVIDER=openai
# OPENAI_API_KEY=

# ── Product analytics and log shipping (optional) ─────────────────────
# POSTHOG_ENABLED=true
# POSTHOG_API_KEY=
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Console build (inlined at image build time; public values) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_POSTHOG_KEY=
# VITE_BRAND=magick-agency

# ── Published ports (both loopback by default) ────────────────────────
# CONSOLE_BIND=127.0.0.1
# CONSOLE_PORT=8080
# SUPER_ADMIN_BIND=127.0.0.1
# SUPER_ADMIN_PORT=8081
