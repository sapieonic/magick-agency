    "./hooks/*": "./src/hooks/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": "^0.500.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.8.4",
    "lucide-react": "^0.500.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.8"
  }
}
