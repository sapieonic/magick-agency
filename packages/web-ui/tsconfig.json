{
  // Source and tests in one program (decision B1). The apps type-check these
  // files again through their own imports; this run covers the package's tests.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
