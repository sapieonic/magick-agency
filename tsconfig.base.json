{
  // One compiler config for source AND tests (decision B1): every
  // package's `lint` runs `tsc --noEmit` over `src` and `test` together, so a
  // broken test file fails lint. Nothing here is ever emitted by tsc: the
  // server is bundled by esbuild (apps/server/scripts/build.mjs) and the UIs by
  // Vite, so module settings describe the bundler, not Node's loader.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false
  }
}
