# One file per environment, e.g. dev-manas.tfvars, staging.tfvars, production.tfvars.
# *.tfvars is git-ignored; only this example is committed. Apply with:
#   terraform workspace select <environment>
#   terraform apply -var-file=<environment>.tfvars

environment = "dev-manas" # must equal the workspace name

# Optional overrides (defaults shown).
# region                             = "ap-south-1"     # must match the server's AWS_REGION
# aws_profile                        = null             # a named profile from ~/.aws/config
# name_prefix                        = "magick-agency"
# bucket_name                        = null             # default: <name_prefix>-<environment>-<account id>
# force_destroy                      = false            # true only for a throwaway dev bucket
# create_access_key                  = true             # the secret is kept in this module's state
# noncurrent_version_expiration_days = 0                # >0 turns versioning on and keeps old versions this long
# extra_tags                         = { Owner = "manas" }

# Server VM (ec2.tf): off unless create_server = true.
# create_server  = false
# instance_type  = "t3.medium"       # 2 vCPU / 4 GB; t4g.medium for arm64
# root_volume_gb = 20                # the swap file comes out of this
# swap_gb        = 2                 # 0 for none
# ami_id         = null              # default: latest Ubuntu 26.04 for the type's architecture
# subnet_id      = null              # default: a default subnet of the default VPC
# ssh_cidrs      = []                # e.g. ["198.51.100.7/32"]; empty opens no SSH port
# ssh_public_key = null              # e.g. file contents of ~/.ssh/id_ed25519.pub
# key_name       = null              # or an existing key pair's name
# enable_ssm     = true              # Session Manager shell + port forwarding
# enable_instance_connect = false    # true: SSH from the console's "EC2 Instance Connect" tab

# Reports (reports.tf): off unless enable_reports = true. aws/README.md, "Reports".
# enable_reports = true is all it needs: the plan builds the renderer's zip from this checkout,
# fetches the Chromium layer (checksum pinned) and the apply generates the callback secret in SSM.
# enable_reports                             = false
# report_renderer_zip                        = null   # a prebuilt zip instead of building one
# report_renderer_handler                    = "index.handler"
# report_renderer_chromium_layer_arn         = null   # an existing layer instead of publishing one
# reports_callback_secret_generation         = 1      # +1 rotates the secret (aws/README.md, "Rotating the callback secret")
# reports_callback_secret_sign_with_previous = false  # mid-rotation only: the Lambda keeps the old secret
# report_renderer_live_version               = null   # an older version number rolls `live` back
# reports_render_timeout_seconds             = 900    # the server's AGENCY_REPORTS_RENDER_TIMEOUT_MS / 1000; >= 900
# report_retention_days                      = 90     # = the server's AGENCY_REPORTS_RETENTION_DAYS
# report_renderer_log_retention_days         = 30
