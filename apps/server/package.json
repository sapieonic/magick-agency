    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.27.3",
    "tsx": "^4.20.0",
    "typescript": "~5.7.3",
    "vitest": "^4.1.8"
  }
