{
  "name": "@magick-agency/server",
  "version": "0.0.0",
  "private": true,
  "description": "The one Magick Agency process: identity, tenancy, super-admin, API, station WS, voice engine, pacing, analysis worker.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --max-old-space-size=4096 --max-http-header-size=16384 dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.config.integration.ts --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.52.0",
    "@magick-agency/contracts": "workspace:*",
    "@magick-agency/db": "workspace:*",
    "@magick-agency/domain": "workspace:*",
    "@magick-agency/observability": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.6.0",
    "firebase-admin": "^13.7.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "pino": "^9.9.0",
    "pino-opentelemetry-transport": "^1.1.0",
    "pino-pretty": "^13.0.0",
    "posthog-node": "^5.55.0",
    "uuid": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
