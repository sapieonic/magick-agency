import { afterAll, beforeEach, describe, expect, it, vi } from 'vitest';
import { closeTestPool, getTestPool, truncateAll } from '../setup/test-utils.js';
import { DEFAULTS, uuidFor } from '../setup/factories.js';

vi.mock('@magick-agency/db', () => ({ getPool: () => getTestPool() }));

const { agencyCampaignRepository, agencyAgentStatsRepository } =
  await import('../../../src/db/repositories/agency.repository.js');
const {
  insertAgencyCampaign, insertAgencyContact, insertAgencyAttempt, insertAgentSession,
} = await import('./agency-factories.js');

/**
 * ─── `is_success`, AGAINST A REAL disposition_catalog ────────────────────────
 *
 * Modelled on `test/integration/agency/agency-campaign-stats.test.ts` — same
 * connection mock, same import order, same "drive `stats()` and read the payload"
 * shape. The agent-record half drives `agencyAgentStatsRepository.stats` the way
 * `agent-stats-timezone-buckets.test.ts` does.
 *
 * ── Why the unit tier cannot close this ─────────────────────────────────────
 *
 * `campaign-conversion-stats.test.ts` mocks the pool, so it asserts that the SQL
 * *string* contains an `EXISTS` and a `'true'::jsonb` comparison, and then feeds
 * the fold a hand-written row. Both halves are useful and neither executes
 * `jsonb_array_elements` even once. Three claims are pure Postgres semantics:
 *
 *   1. **`EXISTS`, not a JOIN.** `jsonb_array_elements` is set-returning, so a
 *      catalog carrying the same `code` twice would produce two rows per attempt
 *      under a JOIN and **double the success count**. Nothing prevents the
 *      duplicate: migration 072 CHECKs only that the column is an array. A mocked
 *      pool cannot fan out, so the choice is untested by construction.
 *   2. **`e->'is_success' = 'true'::jsonb`, never `(e->>'is_success')::boolean`.**
 *      The cast raises `22P02 invalid input syntax for type boolean` on a value
 *      like `"maybe"`, nothing maps that to a status, and the whole stats payload
 *      becomes a 500 carrying the database's error text — over one bad character in
 *      one operator's config. Only a query can show the comparison does not throw.
 *   3. **The element SHAPE guard.** `jsonb_typeof(e) = 'object'` runs before
 *      `e->>'code'`, because a catalog written directly against core can hold
 *      strings, numbers, nulls or nested arrays.
 *
 * Plus the denominator: `success_rate_pct` is over CONNECTED (bridged) attempts,
 * never over `attempts_total`. A dial that rang out had no conversation to
 * convert, so counting it against the script turns the conversion rate into a
 * measure of list quality.
 *
 * ── ⚠️ THIS FILE HAS NOT BEEN EXECUTED ──────────────────────────────────────
 *
 * No Docker daemon, so `npm run test:integration` could not be run. It type-checks
 * under `tsconfig.test.json` (gated by `npm run lint`). Every count below is the
 * number of seeded rows matching the condition named in the comment beside it. The
 * "does not throw" assertions are the mechanical ones; the counts are the inferred
 * ones, and each is stated as an arithmetic identity as well as a literal so a
 * failure says which half is wrong.
 */

const T = DEFAULTS.tenantId;
const A = DEFAULTS.accountId;
const AGENT = uuidFor('u-ravi');

const FROM = new Date('2026-08-10T00:00:00.000Z');
const TO = new Date('2026-08-20T00:00:00.000Z');
const scope = { tenantId: T, accountId: A, agentUserId: AGENT };

/** A catalog entry as the campaign builder writes one. */
const entry = (code: string, isSuccess: unknown) => ({ code, label: code, is_success: isSuccess });

/**
 * A bridged, ended attempt carrying a disposition — the only shape either
 * conversion count looks at.
 *
 * `bridged_at IS NOT NULL` is the gate throughout, deliberately NOT
 * `outcome = 'connected'`: `bridged_at` is the instant media actually joined the
 * two parties, and outcome is a classification that can be absent, late, or say
 * connected about a call no agent ever heard.
 */
async function bridged(
  campaignId: string,
  sessionId: string,
  dispositionCode: string | null,
  at = new Date('2026-08-15T09:00:00Z'),
) {
  const contact = await insertAgencyContact(campaignId, { state: 'completed' });
  return insertAgencyAttempt(campaignId, contact.id as string, {
    state: 'ended',
    outcome: 'connected',
    reserved_agent_id: sessionId,
    disposition_code: dispositionCode,
    created_at: at,
    dialed_at: at,
    bridged_at: at,
    ended_at: new Date(at.getTime() + 60_000),
  });
}

/** A dial that never bridged: in `attempts`, out of every connect bucket. */
async function unbridged(
  campaignId: string,
  sessionId: string,
  at = new Date('2026-08-15T10:00:00Z'),
) {
  const contact = await insertAgencyContact(campaignId, { state: 'completed' });
  return insertAgencyAttempt(campaignId, contact.id as string, {
    state: 'ended',
    outcome: 'no_answer',
    reserved_agent_id: sessionId,
    created_at: at,
    dialed_at: at,
    ended_at: new Date(at.getTime() + 20_000),
  });
}

async function seed(catalog: unknown[]) {
  const campaign = await insertAgencyCampaign({
    default_timezone: 'UTC',
    status: 'stopped',
    disposition_catalog: JSON.stringify(catalog),
  });
  const session = await insertAgentSession(campaign.id as string, {
    agent_user_id: AGENT, joined_at: new Date('2026-08-15T08:00:00Z'),
  });
  return { campaignId: campaign.id as string, sessionId: session.id as string };
}

const agentStats = () => agencyAgentStatsRepository.stats(scope, { from: FROM, to: TO, bucket: 'day' });

describe('conversion counting against a real disposition_catalog (integration)', () => {
  beforeEach(async () => {
    await truncateAll();
  });

  afterAll(async () => {
    await closeTestPool();
  });

  // ── The happy path, on both surfaces ──────────────────────────────────────

  it('counts exactly the bridged attempts whose code maps to an is_success entry', async () => {
    const { campaignId, sessionId } = await seed([
      entry('sale', true),
      entry('appointment', true),
      entry('not_interested', false),
      // No `is_success` key at all — the field is optional on the type, and an
      // absent key must read as "not a success" rather than as anything.
      { code: 'callback', label: 'Callback' },
    ]);

    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'appointment');
    await bridged(campaignId, sessionId, 'not_interested');
    await bridged(campaignId, sessionId, 'callback');
    // Bridged with no write-up at all: a connect, never a conversion.
    await bridged(campaignId, sessionId, null);
    // Not bridged: neither a connect nor a conversion, and it must not reach the
    // denominator.
    await unbridged(campaignId, sessionId);

    const campaign = await agencyCampaignRepository.stats(campaignId);
    expect(campaign.attempts_total).toBe(7);
    expect(campaign.attempts_success).toBe(3);          // 2 × sale + 1 × appointment
    // Denominator is the six BRIDGED attempts, summed from the three connect
    // buckets rather than read as a fourth subquery two others could disagree with.
    expect(campaign.success_rate_pct).toBeCloseTo((3 / 6) * 100, 6);

    const agent = await agentStats();
    expect(agent.totals.attempts).toBe(7);
    expect(agent.totals.connected).toBe(6);
    expect(agent.totals.successes).toBe(3);
    // The agent record's denominator is `connected`, and it is the same 6.
    expect(agent.totals.success_rate_pct).toBeCloseTo((3 / 6) * 100, 6);
    // The two surfaces count the same thing — which is the entire reason the
    // predicate lives in one exported leaf module.
    expect(agent.totals.successes).toBe(campaign.attempts_success);
  });

  it('honours a code the operator later flips to is_success', async () => {
    // The predicate reads the catalog at QUERY time, not at disposition time. So
    // flipping the flag re-scores history, which is the intended behaviour: the
    // operator is declaring what a sale is, not annotating individual calls.
    const { campaignId, sessionId } = await seed([entry('sale', false)]);
    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'sale');

    expect((await agencyCampaignRepository.stats(campaignId)).attempts_success).toBe(0);

    await getTestPool().query(
      `UPDATE agency_campaigns SET disposition_catalog = $2::jsonb WHERE id = $1`,
      [campaignId, JSON.stringify([entry('sale', true)])],
    );
    expect((await agencyCampaignRepository.stats(campaignId)).attempts_success).toBe(2);
    expect((await agentStats()).totals.successes).toBe(2);
  });

  // ── 1. EXISTS, not a JOIN ─────────────────────────────────────────────────

  it('a DUPLICATED catalog code does not double the count', async () => {
    // ── The correctness choice, exercised ────────────────────────────────────
    //
    // Migration 072 CHECKs only `jsonb_typeof(disposition_catalog) = 'array'`, so
    // nothing stops two entries sharing a code — a copy-paste in the builder, a
    // merge of two catalogs. `jsonb_array_elements` is set-returning, so joined
    // against the attempts each duplicate yields another row and the success count
    // DOUBLES. `EXISTS` asks whether any entry matches and stops.
    //
    // Three copies, so a fan-out shows up as 3× rather than as something that could
    // be mistaken for an off-by-one.
    const { campaignId, sessionId } = await seed([
      entry('sale', true),
      entry('sale', true),
      entry('sale', true),
      entry('not_interested', false),
    ]);
    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'not_interested');

    const campaign = await agencyCampaignRepository.stats(campaignId);
    expect(campaign.attempts_success).toBe(2);   // NOT 6
    // And the rate cannot exceed 100%, which is what a fan-out produces first and
    // most visibly.
    expect(campaign.success_rate_pct).toBeCloseTo((2 / 3) * 100, 6);
    expect(campaign.success_rate_pct!).toBeLessThanOrEqual(100);

    const agent = await agentStats();
    expect(agent.totals.successes).toBe(2);
    // `attempts` and `connected` come from the same statement as `successes` in the
    // agent read, so a fan-out there would inflate all three together — which is
    // why they are all pinned rather than just the one under test.
    expect(agent.totals.attempts).toBe(3);
    expect(agent.totals.connected).toBe(3);
    expect(agent.totals.successes).toBeLessThanOrEqual(agent.totals.connected);
  });

  it('a duplicated code with DISAGREEING flags counts as a success (EXISTS is any, not all)', async () => {
    // Stated because it is a real decision rather than an accident: `EXISTS` is an
    // existential, so one `true` among duplicates wins. There is no defensible
    // alternative — nothing says which duplicate is authoritative — and the
    // direction is the same one the strict `= 'true'::jsonb` comparison takes
    // elsewhere: never invent a conversion, but do not discard a declared one
    // because the config is untidy.
    const { campaignId, sessionId } = await seed([entry('sale', false), entry('sale', true)]);
    await bridged(campaignId, sessionId, 'sale');
    expect((await agencyCampaignRepository.stats(campaignId)).attempts_success).toBe(1);
  });

  // ── 2. No boolean cast: a malformed flag must not 500 the payload ──────────

  it('the boolean CAST really does raise 22P02 — so avoiding it is load-bearing', async () => {
    // Asserted directly, first, because every "does not throw" below is only
    // meaningful if the cast genuinely would. This is the exact expression the
    // predicate deliberately does not use.
    await expect(
      getTestPool().query(`SELECT ('{"is_success":"maybe"}'::jsonb->>'is_success')::boolean`),
    ).rejects.toMatchObject({ code: '22P02' });
  });

  it.each([
    ['"maybe"', JSON.stringify('maybe')],
    ['a number', '1'],
    ['a string "true"', JSON.stringify('true')],
    ['null', 'null'],
    ['an object', '{"yes":1}'],
    ['an array', '[true]'],
  ])('survives is_success = %s, counting it as NOT a success', async (_label, rawJson) => {
    // `e->'is_success' = 'true'::jsonb` is a jsonb comparison and cannot throw on
    // any input. The comparison is STRICT: only the JSON literal `true` counts.
    // `1`, `"true"` and `"yes"` read as "not a success" rather than being coerced —
    // the safe direction, since a conversion is never invented from a value nobody
    // meant as one, and it matches what the console writes (a checkbox serialises
    // to `true`).
    const catalog = `[{"code":"sale","label":"Sale","is_success":${rawJson}}]`;
    const campaign = await insertAgencyCampaign({
      default_timezone: 'UTC', status: 'stopped', disposition_catalog: catalog,
    });
    const session = await insertAgentSession(campaign.id as string, {
      agent_user_id: AGENT, joined_at: new Date('2026-08-15T08:00:00Z'),
    });
    await bridged(campaign.id as string, session.id as string, 'sale');

    // The assertion that matters is that this RESOLVES. A 500 here is the defect.
    const stats = await agencyCampaignRepository.stats(campaign.id as string);
    expect(stats.attempts_success).toBe(0);
    // The rate is a real 0%, not null: a call DID bridge, so there is a
    // denominator — "nothing converted" and "nothing measured" stay distinct.
    expect(stats.success_rate_pct).toBe(0);

    const agent = await agentStats();
    expect(agent.totals.successes).toBe(0);
    expect(agent.totals.connected).toBe(1);
    expect(agent.totals.success_rate_pct).toBe(0);
  });

  it('survives a catalog whose ELEMENTS are not objects at all', async () => {
    // The `jsonb_typeof(e) = 'object'` guard, which runs before `e->>'code'` is
    // asked of anything. Migration 072 constrains the column to an array and says
    // nothing about its elements, so a catalog written directly against core — or
    // by a client that got the shape wrong — can hold any of these.
    // `resolveDisposition` is defensive in exactly this way so a malformed catalog
    // cannot 500 an agent's submission; a stats read must not either.
    const catalog = '["sale", 42, null, [true], {"no_code":true}, {"code":"sale","is_success":true}]';
    const campaign = await insertAgencyCampaign({
      default_timezone: 'UTC', status: 'stopped', disposition_catalog: catalog,
    });
    const session = await insertAgentSession(campaign.id as string, {
      agent_user_id: AGENT, joined_at: new Date('2026-08-15T08:00:00Z'),
    });
    await bridged(campaign.id as string, session.id as string, 'sale');

    // Resolves, and the one WELL-FORMED entry is still honoured — the guard skips
    // the junk rather than abandoning the array.
    expect((await agencyCampaignRepository.stats(campaign.id as string)).attempts_success).toBe(1);
    expect((await agentStats()).totals.successes).toBe(1);
  });

  it('survives an EMPTY catalog, which is the column default', async () => {
    // `'[]'` is what migration 072 defaults to, so this is every campaign that has
    // never had a catalog configured. `EXISTS` over an empty set is false, and the
    // statement must plan and run rather than divide by anything.
    const { campaignId, sessionId } = await seed([]);
    await bridged(campaignId, sessionId, 'sale');
    const stats = await agencyCampaignRepository.stats(campaignId);
    expect(stats.attempts_success).toBe(0);
    expect(stats.success_rate_pct).toBe(0);
  });

  it('a NULL disposition_code matches no entry, even one with a null code', async () => {
    // `e->>'code' = a.disposition_code` is NULL — never true — when either side is
    // NULL, which is why the predicate deliberately carries no
    // `disposition_code IS NOT NULL` guard: adding one would be a redundant clause
    // that reads like it is doing work. The adversarial case is a catalog entry
    // whose `code` is itself null, where a naive `IS NOT DISTINCT FROM` would match.
    const catalog = '[{"code":null,"is_success":true},{"code":"sale","is_success":true}]';
    const campaign = await insertAgencyCampaign({
      default_timezone: 'UTC', status: 'stopped', disposition_catalog: catalog,
    });
    const session = await insertAgentSession(campaign.id as string, {
      agent_user_id: AGENT, joined_at: new Date('2026-08-15T08:00:00Z'),
    });
    await bridged(campaign.id as string, session.id as string, null);

    expect((await agencyCampaignRepository.stats(campaign.id as string)).attempts_success).toBe(0);
    expect((await agentStats()).totals.successes).toBe(0);
  });

  // ── 3. The denominator ────────────────────────────────────────────────────

  it('success_rate_pct is denominated on BRIDGED attempts, never on attempts_total', async () => {
    // ── Why the choice is visible only with unbridged rows present ────────────
    //
    // With every attempt bridged the two denominators are equal, which is what a
    // fixture naturally produces. Here twelve attempts and three bridges make them
    // differ by a factor of four, so `attempts_total` as the denominator would
    // report 8.3% where the truth is 33.3% — a conversion rate turned into a
    // measure of list quality.
    const { campaignId, sessionId } = await seed([entry('sale', true)]);
    await bridged(campaignId, sessionId, 'sale');
    await bridged(campaignId, sessionId, 'not_in_catalog');
    await bridged(campaignId, sessionId, null);
    for (let i = 0; i < 9; i++) {
      await unbridged(campaignId, sessionId, new Date(`2026-08-15T1${i}:00:00Z`));
    }

    const campaign = await agencyCampaignRepository.stats(campaignId);
    expect(campaign.attempts_total).toBe(12);
    expect(campaign.attempts_success).toBe(1);
    expect(campaign.success_rate_pct).toBeCloseTo((1 / 3) * 100, 6);
    // Explicitly NOT the other reading.
    expect(campaign.success_rate_pct).not.toBeCloseTo((1 / 12) * 100, 6);

    const agent = await agentStats();
    expect(agent.totals.attempts).toBe(12);
    expect(agent.totals.connected).toBe(3);
    expect(agent.totals.success_rate_pct).toBeCloseTo((1 / 3) * 100, 6);
    // The connect rate uses the other denominator, and the two must not have been
    // swapped.
    expect(agent.totals.connect_rate_pct).toBeCloseTo((3 / 12) * 100, 6);
  });

  it('is NULL — never 0 — when nothing has bridged', async () => {
    // The rule `abandonment_rate_24h_pct` has carried since it was introduced, now one
    // exported helper. "Nothing has converted yet" and "nothing has been measured
    // yet" are different facts, and a `0` renders both as the same confident,
    // flattering number — which is how a supervisor reads `success 0.0%` on a
    // campaign whose first call has not connected and concludes something about
    // the script.
    const { campaignId, sessionId } = await seed([entry('sale', true)]);
    await unbridged(campaignId, sessionId);
    await unbridged(campaignId, sessionId, new Date('2026-08-15T11:00:00Z'));

    const campaign = await agencyCampaignRepository.stats(campaignId);
    expect(campaign.attempts_total).toBe(2);
    expect(campaign.attempts_success).toBe(0);
    expect(campaign.success_rate_pct).toBeNull();

    const agent = await agentStats();
    expect(agent.totals.connected).toBe(0);
    expect(agent.totals.success_rate_pct).toBeNull();
    // The connect rate DOES have a denominator here, so it is a real 0 — the two
    // rules side by side, which is the pairing that makes either legible.
    expect(agent.totals.connect_rate_pct).toBe(0);
    // And AHT, which shares the zero-denominator branch through `ratio`.
    expect(agent.totals.aht_seconds).toBeNull();
  });

  it('is NULL on a campaign with no attempts at all', async () => {
    const { campaignId } = await seed([entry('sale', true)]);
    const campaign = await agencyCampaignRepository.stats(campaignId);
    expect(campaign.attempts_total).toBe(0);
    expect(campaign.attempts_success).toBe(0);
    expect(campaign.success_rate_pct).toBeNull();

    const agent = await agentStats();
    expect(agent.totals.attempts).toBe(0);
    expect(agent.totals.connect_rate_pct).toBeNull();
    expect(agent.totals.success_rate_pct).toBeNull();
  });

  it('scopes conversions to the campaign, so another campaign\'s catalog cannot count', async () => {
    // The catalog is joined on `c.id = a.campaign_id`, so the flag that scores an
    // attempt is its OWN campaign's. Two campaigns using the same code with
    // opposite flags is the ordinary case once an operator copies a campaign, and
    // an unqualified join would score both by whichever row came back.
    const yes = await seed([entry('sale', true)]);
    // Closed BEFORE the second is seeded: migration 093's
    // `uq_agency_agent_live_tenant (tenant_id, agent_user_id) WHERE left_at IS NULL`
    // refuses a second live session for one person in one tenant, so a fixture that
    // created both and closed one afterwards would fail on the index rather than
    // testing anything.
    await getTestPool().query(
      'UPDATE agency_agent_sessions SET left_at = $2 WHERE id = $1',
      [yes.sessionId, new Date('2026-08-15T09:30:00Z')],
    );
    const no = await seed([entry('sale', false)]);

    await bridged(yes.campaignId, yes.sessionId, 'sale');
    await bridged(no.campaignId, no.sessionId, 'sale');

    expect((await agencyCampaignRepository.stats(yes.campaignId)).attempts_success).toBe(1);
    expect((await agencyCampaignRepository.stats(no.campaignId)).attempts_success).toBe(0);

    // And cross-campaign on the agent record: one success out of two connects.
    const agent = await agentStats();
    expect(agent.totals.connected).toBe(2);
    expect(agent.totals.successes).toBe(1);
    expect(agent.totals.campaigns).toBe(2);
    // `by_campaign` partitions it, so the reader can see WHICH campaign converted.
    const byCampaign = new Map(agent.by_campaign.map((r) => [r.campaign_id, r.successes]));
    expect(byCampaign.get(yes.campaignId)).toBe(1);
    expect(byCampaign.get(no.campaignId)).toBe(0);
  });
});
