# magick-agency server. Copy to .env. Ports are agency's own (see docker/docker-compose.dev.yml).
NODE_ENV=development
PORT=3021
LOG_LEVEL=info
DATABASE_URL=postgresql://magick_agency:magick_agency_password@localhost:5436/magick_agency
REDIS_URL=redis://localhost:6383/0

# Super-admin API (/super-admin/*), at least 16 characters. Unset = those routes are not
# registered and the super-admin UI cannot log in.
# SUPER_ADMIN_JWT_SECRET=change-me-at-least-16-chars

# Console sign-in (Firebase). The block is on only when FIREBASE_PROJECT_ID is set; without it,
# outside production, every console token check fails with 401. Production refuses to boot
# without it. No service account: ID tokens are verified against Google's public keys and this
# project id. Use the same project as the console's VITE_FIREBASE_PROJECT_ID
# (apps/console/.env.example).
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# VoiceLink (real calls). Once TELEPHONY_ENABLED_PROVIDERS names voicelink (or NODE_ENV is
# production), the four fields below are required and boot fails naming each missing one.
# Unset = the server boots but places no real calls. VOICELINK_WEBHOOK_BASE_URL is this server's
# PUBLIC https origin PLUS the path /api/v1/webhooks/voicelink: status webhooks go to
# <base>/webrtc-status/:id, and the media WebSocket uses only its host. A bare origin makes every
# status webhook 404. In dev point a tunnel at :3021 and restart when its URL changes.
# There is no caller-ID setting: each campaign carries its own caller_ids, set by the tenant.
# VOICELINK_DEFAULT_COUNTRY_CODE has no `+` and defaults to 91.
# TELEPHONY_ENABLED_PROVIDERS=voicelink
# VOICELINK_BASE_URL=https://app.voicelink.co.in/api
# VOICELINK_USERNAME=
# VOICELINK_PASSWORD=
# VOICELINK_WEBHOOK_BASE_URL=https://<public host>/api/v1/webhooks/voicelink
# VOICELINK_DEFAULT_COUNTRY_CODE=91

# S3 (roster CSV uploads, rejected-row exports, abandon clips). The client starts only when
# S3_AUDIO_BUCKET is set; without it every upload fails with "S3 client not initialized".
# Credentials are read from these two keys only (no profile or role). aws/README.md provisions
# a bucket and IAM user per environment and prints these lines: terraform output -raw server_env
# S3_AUDIO_BUCKET=magick-agency-<environment>-<account id>
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Call analysis (transcription + LLM analysis of recorded calls) ─────────────────────────
# Every AI call goes through one client layer (src/ai/): openai_compatible, azure_openai or
# gemini. A missing key does not stop boot; the feature logs a warning and stays off. Look for
# "Dialer call-analysis worker enabled" at startup. A call is analysed only when ALL hold: the
# worker is on (below), the agency_call_analysis flag is on for the tenant (default OFF), the
# account may record (allow_recording, default off, set in super-admin), the campaign records
# calls (record_calls, default off), VoiceLink delivers the recording URL (needs a working
# VOICELINK_WEBHOOK_BASE_URL), its host is on VOICELINK_RECORDING_HOSTS (see Recordings below),
# and the call was answered with >= 10 s of talk.
#
# Worker on/off, and the flag's default. A super-admin override per tenant or account wins
# over FF_AGENCY_CALL_ANALYSIS.
# DIALER_ANALYSIS_ENABLED=true
# FF_AGENCY_CALL_ANALYSIS=true

# Transcription: gemini (default) or sarvam (Indian languages only, model saarika:v2).
# Gemini runs through the AI layer's gemini client (Files API upload, then one request per window).
# DIALER_TRANSCRIBER=gemini
# DIALER_TRANSCRIBE_MODEL=gemini-3.5-flash
# A dedicated key keeps hour-long transcriptions from eating other Gemini quota. Falls back to
# GEMINI_API_KEY.
# DIALER_TRANSCRIBE_API_KEY=
# DIALER_TRANSCRIBE_SARVAM_API_KEY=                      # falls back to SARVAM_API_KEY
# SARVAM_API_KEY=

# Post-call analysis: pick ONE provider and set its block. On by default once a key is set
# (POST_CALL_ANALYSIS_ENABLED=false turns it off).
# POST_CALL_ANALYSIS_ENABLED=true
# POST_CALL_ANALYSIS_PROVIDER=openai_compatible          # openai_compatible | azure_openai | gemini
# The model id the provider expects. Unset = gpt-4o-mini (openai_compatible, azure_openai) or
# gemini-3.5-flash (gemini).
# POST_CALL_ANALYSIS_MODEL=gpt-4o-mini
#
#   openai_compatible: OpenAI itself (no base URL), or any Chat Completions endpoint: OpenRouter,
#   Together, Groq, LiteLLM, vLLM, Ollama... A keyless self-hosted endpoint needs only the base URL.
# Falls back to OPENAI_API_KEY only when BASE_URL is unset: OpenAI's key never goes to another host.
# POST_CALL_ANALYSIS_API_KEY=
# OPENAI_API_KEY=
# POST_CALL_ANALYSIS_BASE_URL=https://openrouter.ai/api/v1   # include the version path; unset = OpenAI
# POST_CALL_ANALYSIS_HEADERS=HTTP-Referer=https://agency.example.com,X-Title=Magick Agency
# Use json_object for endpoints without json_schema support (the schema then goes in the prompt).
# POST_CALL_ANALYSIS_STRUCTURED_OUTPUT=json_schema       # json_schema | json_object
#
#   azure_openai: the model is sent as `model`, and is the deployment when no deployment is set.
# POST_CALL_ANALYSIS_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# POST_CALL_ANALYSIS_AZURE_API_KEY=                      # falls back to POST_CALL_ANALYSIS_API_KEY
# POST_CALL_ANALYSIS_AZURE_DEPLOYMENT=
# POST_CALL_ANALYSIS_AZURE_API_VERSION=2024-12-01-preview
#
#   gemini: the native Gemini API (not its OpenAI-compatible endpoint).
# POST_CALL_ANALYSIS_API_KEY=                            # falls back to GEMINI_API_KEY
# GEMINI_API_KEY=                                        # shared with transcription (above)
#
# What the analysis model is given. transcript (default): the transcript only, any provider.
# audio: the recording AND the transcript, so tone, emotion, interruptions and silences count.
# audio needs POST_CALL_ANALYSIS_PROVIDER=gemini (refused at boot otherwise) and uploads the
# recording a second time (once to transcribe, once to analyse); the upload is deleted after.
# POST_CALL_ANALYSIS_INPUT=transcript                    # transcript | audio
#
# Tuning (defaults shown). TEMPERATURE=none sends none, for models that refuse one (OpenAI
# reasoning models); Gemini 3.x ignores it either way. The timeout defaults to 30000 for
# transcript input and 180000 for audio input.
# POST_CALL_ANALYSIS_TEMPERATURE=0.3
# POST_CALL_ANALYSIS_TIMEOUT_MS=30000
# POST_CALL_ANALYSIS_MAX_TURNS=200
# DIALER_ANALYSIS_CONCURRENCY=2                          # transcriptions at once, this process
# DIALER_ANALYSIS_POLL_INTERVAL_MS=60000
# DIALER_ANALYSIS_MIN_TALK_TIME_SECONDS=10
# DIALER_ANALYSIS_MAX_ATTEMPTS=3
# DIALER_TRANSCRIBE_WINDOW_SECONDS=600
# DIALER_TRANSCRIBE_TIMEOUT_MS=180000
# DIALER_TRANSCRIBE_MAX_OUTPUT_TOKENS=16384              # per window; MAX_TOKENS windows are split
# DIALER_MAX_RECORDING_BYTES=52428800                    # 50 MiB, the most audio buffered
# DIALER_ANALYSIS_MAX_ATTEMPTS_TOTAL=8                   # lifetime, manual retries included
# DIALER_ANALYSIS_SETTLE_SECONDS=15                      # wait before the first recording fetch
# DIALER_ANALYSIS_RECORDING_WAIT_MINUTES=30              # then the job expires with no recording
# Re-fetches of a failed or truncated recording, without using an attempt (delay doubles).
# DIALER_ANALYSIS_RECORDING_FETCH_RETRIES=2
# DIALER_ANALYSIS_RECORDING_FETCH_RETRY_DELAY_SECONDS=15

# Reverse-proxy hops in front of this service (TRUST_PROXY_HOPS). A COUNT, never
# `true`: `true` trusts the whole X-Forwarded-For chain and resolves request.ip to its leftmost
# entry, which is client-controlled - and request.ip keys every IP rate-limit bucket. 1 = one
# proxy (nginx / a load balancer) appends the client address. Never 0 or blank (boot error).
# DEPLOYMENT INVARIANT: this server must be reachable ONLY through exactly N proxies (bind it to
# loopback / a private interface, or firewall the port). If it is reachable directly, a client's
# own X-Forwarded-For entry becomes request.ip and the IP rate limits can be evaded; if the real
# chain has a different number of proxies, set N to match it.
# TRUST_PROXY_HOPS=1

# Postgres TLS (on when NODE_ENV=production). The server certificate is VERIFIED by default.
# DB_SSL_CA is the PEM TEXT of a private CA (not a file path); `\n` escapes are allowed on one
# line. Opting out of verification needs exactly `false`. TLS parameters in DATABASE_URL
# (ssl, sslmode, sslrootcert, sslcert, sslkey, sslnegotiation) are refused at boot: pg would let them replace
# these settings.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----
# DB_SSL_REJECT_UNAUTHORIZED=true

# ── Recordings (playback and analysis) ──────────────────────────────────────────────────────
# Hosts the server may fetch call recordings from (https, exact or subdomain, every redirect
# checked). Unset = VoiceLink's recording host below. A comma list REPLACES it, so keep it in the
# list; set EMPTY to refuse every recording fetch and playback. A VoiceLink account can deliver
# recordings from another host: a refusal logs "Recording URL is not on the VoiceLink
# recording-host allow-list" with the host, and playback answers 502 (docs/operations.md).
# VOICELINK_RECORDING_HOSTS=recording.app.voicelink.co.in
# Stable HMAC key for recording playback links (16+ chars); unset = a per-process key, so links
# break on restart.
# RECORDING_URL_SIGNING_SECRET=change-me-at-least-16-chars

# Retention. Transcripts (conversation_log, transcript_meta) are nulled after 30 days by default
# (falls back to DIALER_TRANSCRIPT_RETENTION_DAYS). Call rows are KEPT unless
# AGENCY_RETENTION_DAYS is set, and it must be >= RETENTION_MIN_DAYS (30) or boot fails.
# AGENCY_TRANSCRIPT_RETENTION_DAYS=30
# AGENCY_RETENTION_DAYS=400
# RETENTION_MIN_DAYS=30
# RETENTION_PURGE_INTERVAL_MS=86400000                   # daily
# RETENTION_SLACK_WEBHOOK_URL=                           # unset = no Slack summary of each purge

# Redis (REDIS_URL) must keep keys for their TTL: persistence on (AOF/RDB) and `noeviction`
# (or a volatile-* policy with nothing else competing). Call tokens are verified against it and
# a token lost early is REFUSED, so eviction or a non-persistent restart cuts live calls'
# carrier legs and status webhooks.

# OpenTelemetry (src/instrumentation.ts). Traces, metrics and logs are exported over OTLP
# (http/protobuf) only when OTEL_ENABLED is exactly `true` AND the endpoint AND OTEL_SERVICE_NAME
# are set; otherwise no SDK starts, every metric is a no-op and logs go to stdout only.
# OTEL_SERVICE_NAME is what Grafana selects and pages on: `magick-agency` = production,
# `magick-agency-Staging`, `magick-agency-Dedicated`. Use another name (e.g. `agency-dev-<you>`)
# for anything else; no rule selects it. Logs reach OTLP through the
# SDK's pino bridge. The endpoint is the base URL (/v1/traces, /v1/metrics, /v1/logs are
# appended). Headers are `key=value` pairs, comma-separated; Grafana Cloud wants
# `Authorization=Basic <base64 id:token>`. Standard OTEL_RESOURCE_ATTRIBUTES still overrides.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
# OTEL_SERVICE_NAME=magick-agency-Staging
# OTEL_ENVIRONMENT=production
# Metric export interval; anything not a positive number falls back to 60000 (Grafana Cloud
# bills above one data point per minute per series).
# OTEL_METRICS_EXPORT_INTERVAL_MS=60000
# Adds service.instance.id (OTEL_SERVICE_INSTANCE_ID, else the hostname). Off by default: it
# multiplies every series by the replica count. This app runs one replica.
# OTEL_SERVICE_INSTANCE_ID_ENABLED=false
# OTEL_LOG_LEVEL=debug
