{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    // No `types` allow-list: every visible `@types/*`
    // (react, and the root's node) is included. `src/brand/load-brand.ts` and
    // `vite.config.ts` read the brand pack with `node:fs` at build time.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
