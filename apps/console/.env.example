# magick-agency console. Copy to .env.local (git-ignored); Vite does not read this file.

# Firebase web app config (Firebase console: Project settings > General > Your apps). Use the
# same project as the server's FIREBASE_PROJECT_ID (apps/server/.env.example).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API origin. Leave unset in dev: the dev server proxies the API prefixes to localhost:3021.
# Empty in the production build too, since nginx serves the console and the API on one origin.
# VITE_API_BASE_URL=

# Product analytics. Off unless VITE_POSTHOG_KEY is set.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_ENVIRONMENT=development
