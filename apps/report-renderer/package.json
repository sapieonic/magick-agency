{
  "name": "@magick-agency/report-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Renders report datasets to PDF (React → HTML → headless Chromium) and Excel (exceljs streaming writer); runs as a Lambda or in the server process (RP15).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build-lambda.mjs",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@magick-agency/contracts": "workspace:*",
    "exceljs": "4.4.0",
    "puppeteer-core": "25.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.27.3",
    "pdfjs-dist": "6.4.299",
    "typescript": "~5.7.3",
    "vitest": "^4.1.8"
  }
}
