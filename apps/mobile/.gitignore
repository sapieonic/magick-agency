migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Personal build-time config (dev-setup.md, step 7): copies of env/*.json with your own values.
/env/*.local.json

# Firebase's native config files. The app reads its Firebase settings from env/*.local.json at
# build time and never these, so a downloaded copy stays on your machine.
google-services.json
GoogleService-Info.plist

# iOS signing material: certificates, provisioning profiles and App Store Connect API keys.
*.p12
*.cer
*.mobileprovision
*.p8
